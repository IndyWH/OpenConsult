# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Environment / secrets — never commit these. The glob covers backups and
# variants (.env.bak, .env.local); the template is the one exception.
.env
.env.*
!.env.example

# Security working documents at the repo root (audit findings, review
# notes) may name live weaknesses and are deliberately kept out of a
# repository whose history is destined to be public.
/*FINDINGS*.md
/*REVIEW*.md

# Test artifacts
.pytest_cache/

# Editors and assistant tooling. .claude/ holds per-machine permission
# settings for the coding assistant; never part of the project.
.vscode/
.idea/
.claude/

# Audio recordings and model files are large — decide per-file what to track
*.wav
*.mp3
models/

# ...but small test fixtures are tracked
!tests/data/*.wav

# Session data: consultation recordings and disposable TTS samples
data/

# Guideline corpus: fetched locally, never committed (copyright).
# The manifest is per-installation and local (like .env); only the example
# manifest is committed. scripts/ingest_guidelines.py rebuilds the corpus.
corpus/*
!corpus/manifest.example.yaml
