# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Environment / secrets — never commit these
.env

# Test artifacts
.pytest_cache/

# Editors
.vscode/
.idea/

# Audio recordings and model files are large — decide per-file what to track
*.wav
*.mp3
models/

# ...but small test fixtures are tracked
!tests/data/*.wav

# Session data: consultation recordings and disposable TTS samples
data/

# Guideline corpus: fetched locally, never committed (copyright).
# The manifest is committed and rebuilds it via scripts/ingest_guidelines.py.
corpus/*
!corpus/manifest.yaml
