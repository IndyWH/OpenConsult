# OpenConsult: the keys of the cloud services, for a developer running
# from source (spec 7.3, rule 3). Copy this file to .env in the data folder
# and fill in the values. Never commit a real value.
# The two speech services (15.9), and the language model hosts the bench
# reads with --key-folder (15.13, runs 9a and 9a2).
SPEECHMATICS_API_KEY=
ASSEMBLYAI_API_KEY=
OLLAMA_API_KEY=
DEEPINFRA_API_KEY=
