# Copy this file to .env and adjust if needed.
# .env is gitignored — real credentials never leave this machine.
DATABASE_URL=postgresql://consultation_app:consultation_dev_password@localhost:5432/consultation_ai
# Signs session cookies. REQUIRED: the app refuses to start while this is
# missing, empty, shorter than 32 characters, or left on a placeholder
# (change-me / dev-secret-change-me) — so a copied-but-unedited .env fails
# fast instead of running on a known key. Generate a real value with:
#   openssl rand -hex 32
SECRET_KEY=change-me
# Reverse-proxy peers whose X-Forwarded-For is trusted for rate limiting
# and audit IPs (DOCKER_DEMO_SPEC.md §1.1). Default: loopback only — the
# host deployment, where Tailscale Serve/Funnel terminates on 127.0.0.1.
# Docker Compose sets this to the bridge subnet; leave unset on the host.
#TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# --- Finalisation transcript-quality gate (TRANSCRIPT_QUALITY_GATE_SPEC.md §11)
# Refuses to draft a note from a transcript that is not faithful to the
# audio (consultation #70). Enabled by default INCLUDING during the public
# demo: a refusal in front of an audience is embarrassing, a fabricated
# clinical note in front of an audience is worse. Setting this false is a
# break-glass switch, not a demo convenience — it logs loudly when disabled.
TRANSCRIPT_GATE_ENABLED=true
# Acting thresholds, owner-set 2026-07-25 from the calibration table.
# S2 and S4 refuse INDEPENDENTLY — either alone is enough.
TRANSCRIPT_MIN_AVG_CONFIDENCE_REFUSE=0.60
# S4 FALLBACK ONLY since 2026-07-28. S4 now decides on CONTENT, not duration
# (owner's rule: silence is ignored however long it is, untranscribed speech
# refuses however short it is). This tolerance survives for the single case
# where the trailing region cannot be measured at all — no audio on disk.
TRANSCRIPT_TRUNCATION_REFUSE_S=20
# S4's content check: windowed RMS from the ORIGINAL wav, thresholded against a
# percentile of THIS recording's own transcribed-speech energy, and decided on
# the longest continuous run above it. Deliberately not a second silero VAD
# pass — the VAD finding no speech is often what created the gap.
# A noise-floor multiple was tried and measured wrong: a long silent tail drags
# the floor down, so the quieter the room the more sensitive it became.
TRANSCRIPT_TRAILING_WINDOW_S=0.25
TRANSCRIPT_TRAILING_SPEECH_FRACTION=0.5
TRANSCRIPT_TRAILING_REF_PCT=75
# Measured longest run in the trailing region: 449 (silent room) 2.25 s,
# 445 (missed speech) 4.75 s, a constructed 10 s utterance 9.50 s. 3.0 s
# separates all three; the 445 margin is 1.75 s and that is thin, so every
# measured value is stored on the consultation for recalibration.
TRANSCRIPT_TRAILING_MIN_RUN_S=3.0
# Flag tier — ACTING since 2026-07-31 (spec §11): S2 in [refuse, flag)
# or a trailing gap over the flag threshold that did not refuse gives
# outcome 'flagged' — the draft proceeds, approval waits on the amber
# banner's acknowledgement. The values are the owner's 2026-07-25 numbers.
TRANSCRIPT_MIN_AVG_CONFIDENCE_FLAG=0.70
TRANSCRIPT_TRUNCATION_FLAG_S=10
# S3 flag (owner decision 2026-07-30, from the re-calibration's measured
# corridor: #70 at 0.727 vs <=0.333 everywhere else): the within-segment
# repetition share over segments of >= TRANSCRIPT_S3_MIN_SEGMENT_TOKENS
# flags above this. Flag only — S3 never refuses. S1 stays measure-only
# (its corridor is 0.013 wide; see app/transcript_quality.py).
TRANSCRIPT_S3_WITHIN_FLAG=0.5
TRANSCRIPT_S3_MIN_SEGMENT_TOKENS=12
# Measured only. S1 does not act: single-window detection returns English
# at p=0.90 for #70. Deferred pending the multi-window redesign and its
# own calibration run (spec §11).
TRANSCRIPT_EXPECTED_LANGUAGE=en

# --- Phase 7a tap-to-ask speech (PHASE_7A_SPEC.md Part 7) -------------------
# The system's own voice. Piper, fully local, CPU ONLY — finalize.py's VRAM
# sequencing assumes sole ownership of the 24 GB card.
#
# Piper runs as a SUBPROCESS from its OWN environment — there is no
# `import piper` in this app and there must not be one. Owner's decision
# 2026-07-25: piper-tts is GPL-3.0-or-later and links espeak-ng, and
# adding it to pyproject.toml would re-resolve the app's lockfile (the
# churn that corrupted this machine's CUDA wheels once before). Install:
#   uv tool install piper-tts
TTS_ENABLED=true
# Pinned voice — owner decision D3. It is part of what the 7b face study
# measures, so changing it mid-study is a confound.
TTS_VOICE=en_GB-alba-medium
# Absolute path to the .onnx voice model (its .onnx.json sits beside it).
# Kept OUTSIDE the repo — the model is 63 MB and is never committed.
TTS_MODEL_PATH=/home/wajir/.local/share/piper-voices/en_GB-alba-medium/en_GB-alba-medium.onnx
# The synthesis command. {model} and {output} are substituted; the text to
# speak goes on STDIN, never on argv (/proc is world-readable and the
# questions are clinical content). No shell is used. Note --cuda is NOT
# passed, and the tool environment's onnxruntime is a CPU-only build with
# no CUDA provider available at all.
# Use an ABSOLUTE path to the executable: consultation-ai.service inherits
# systemd's default PATH, which does not include ~/.local/bin, so a bare
# `piper` resolves in a shell and fails under the service.
TTS_COMMAND="/home/wajir/.local/bin/piper --model {model} --output-file {output}"
TTS_TIMEOUT_S=30
# Hard refusal cap. Bounds both a pathological agenda string and the
# transcript-exclusion window — a window is only as trustworthy as its
# length is known.
SPEECH_MAX_UTTERANCE_S=20
# Extra audio excluded after playback ends, covering speaker/room decay.
SPEECH_EXCLUSION_TAIL_MS=200
SPEECH_CACHE_DIR=data/speech_cache
# Barge-in ships OFF: hard mute is this design with the detector disabled.
# It flips only when scripts/calibrate_barge_in.py meets BOTH sides of the
# D5 target in the real room at real speaker volume (false stops <= 1% of
# utterances AND >= 90% of true interruptions caught within 300 ms) —
# flipping it is the OWNER'S act. Detector built 2026-07-29 (7a session
# 3): a second echo-cancelled client stream, threshold proportional to
# the playback envelope scaled by the loopback level from the
# speech.sound_check audit rows. A comfort feature: exclusion is
# structural, so no value here can corrupt a transcript.
BARGE_IN_ENABLED=false
# Absolute floor (RMS). Empty = 0.02, an UNCALIBRATED GUESS between this
# project's own measurements: room noise 0.008-0.011, real speech
# 0.056-0.153 (consultation 445). Set from the calibration script's report.
BARGE_IN_RMS_THRESHOLD=
# Sustained energy required before a cut — a door slam is a spike, speech
# is a run. Also an uncalibrated first value (spec Part 7).
BARGE_IN_MIN_MS=150
# Mic energy must exceed the predicted residual echo (loopback level x
# playback envelope) by this factor. Uncalibrated first guess.
BARGE_IN_MARGIN=2.0

# --- Exclusion backstops (consultation 445, 2026-07-25) --------------------
# One utterance silenced six minutes of a consultation and nothing
# objected. These convert an invisible over-reach into something that
# announces itself, whatever the next cause turns out to be.
#
# A segment is discarded by the silence invariant only when at least this
# fraction of it lies inside muted audio. The first version dropped on ANY
# overlap, which threw away a 204 s turn to remove 12.7 s of our own
# speech. A hallucination on silence sits wholly inside a span (~1.0); a
# turn that merely contains one is a few per cent.
SEGMENT_MUTED_FRACTION=0.5
# Union of excluded spans as a share of the recording, above which the
# consultation is flagged and counted on the pulse. A ceiling on absurdity,
# not a tight bound: 445 sat at 10.1% while being a serious incident, so
# this would NOT have caught it.
MAX_EXCLUDED_FRACTION=0.25

# --- Phase 7b face drive (PHASE_7B_FACE_DRIVE_SPEC.md, 2026-08-01) ---------
# The drive rewritten after consultation 463. Nothing here integrates: no
# value below can make the face drift with time, only make it read wrong.
#
# Which arm of the planned face-on empathy study this session runs:
# "full" (the default) or "clinical", the narrow-range comparison arm.
# Read once at driver creation. A session run in the WRONG ARM is only
# detectable afterwards, from the drive and mode fields on the
# face.toggled audit row — nothing on screen says which arm is live.
FACE_EXPRESSION_MODE=full
# Clinical arm only: how far a banded muscle may move either side of
# neutral. Ignored in full mode.
FACE_BAND=0.15
# Face states are computed and sent at this rate while the face is on.
FACE_TICK_HZ=5
# Seconds to reach ~63% of a new affect's target chemistry (~96% in 20 s).
FACE_AFFECT_RAMP_S=6
# Seconds for attention to rise while the room is audible.
FACE_ATTENTION_ATTACK_S=0.8
# Seconds for attention to fall back once the room goes quiet.
FACE_ATTENTION_RELEASE_S=5.0
# Adrenaline added at full attention — the eyelid and outer-brow lift.
FACE_ATTENTION_GAIN=0.15
# Room audio above this RMS (fraction of full scale) counts as activity.
# WANTS CALIBRATING FROM A REAL ROOM RECORDING: the default is inherited
# from the silence-nudge activity floor in live.html, so the face and the
# nudge cannot disagree about when the room is quiet.
FACE_ACTIVITY_RMS=1e-4

# --- Phase 7c supervised auto history-taking (PHASE_7C_SPEC.md §12) --------
# THE GATE. Ships false: everything in 7c builds and tests dark behind it,
# and with it false the app behaves exactly as it did before 7c. Flipping it
# is the OWNER'S act, after barge-in calibration and the mock-patient-round
# review — not a code change.
AUTO_MODE_ENABLED=false
# Golden window (encouragers only, zero questions) from the invitation's end.
# Owner decision 2026-08-16: 1-2 min, prereg amendment A1; recorded per run.
AUTO_GOLDEN_MINUTES_S=90
# UNCALIBRATED GUESS (mock-patient round informs it): quiet this long earns
# the single bridging encourager in the question phases while the CDS
# revision runs. Does not govern the golden window (see the next setting).
AUTO_ENCOURAGER_QUIET_S=1.75
# Owner decision 2026-09-01 (solo pilot): in the golden window at most ONE
# encourager ("go on"), issued only once the quiet has reached this length,
# and never after the window has run. Replaces the three-phrase rotation on
# an 8 s cooldown (AUTO_ENCOURAGER_COOLDOWN_S, retired).
AUTO_ENCOURAGER_MIN_QUIET_S=5.0
# UNCALIBRATED GUESS (mock-patient round): quiet this long triggers the
# end-of-turn officer call.
AUTO_EOT_QUIET_S=3.0
# Officer fail-soft: quiet this long counts as a finished thought when the
# officer errored or timed out. Longer than AUTO_EOT_QUIET_S: err toward
# waiting.
AUTO_EOT_FALLBACK_S=5.0
# UNCALIBRATED GUESS (mock-patient round): the officer call's timeout before
# the fallback applies.
AUTO_OFFICER_TIMEOUT_S=2.0
# Owner decision 2026-09-07 (pilot 485 E4): while a CDS pass is in flight the
# officer waits behind it instead of timing out — a busy model is a wait, not
# a failure — bounded by this; the deferral is audited (auto.officer_deferred).
AUTO_OFFICER_MAX_WAIT_S=30
# UNCALIBRATED GUESS (mock-patient round): the topic call's timeout (D1);
# on timeout the agenda question is asked verbatim.
AUTO_TOPIC_TIMEOUT_S=2.0
# Pre-synthesise the top agenda question during the patient's turn.
AUTO_PRESYNTH=true
# D2 posture (owner decision 2026-08-16), re-meant by the standing question
# queue (AGENDA_QUEUE_SPEC.md §4, 2026-09-07): true = a full CDS pass is
# requested on every answer (the urgency check runs as often as before);
# asking never waits for it — the next question comes from the queue's head
# at the turn end. false = no pass on every answer (one is still requested
# when the queue is empty). Flippable so the mock-patient round can compare
# postures as a recorded per-run threshold.
AUTO_STRICT_REVISE=true
# Owner decision 2026-09-07 (pilot 485 E3): the urgency ratchet matches a
# re-fired action to the pending/acknowledged ones by MEANING — lower-cased,
# punctuation stripped, a small stop-word list removed, token-set similarity
# at or above this. A reworded action ("Consider hospital admission" →
# "Immediate referral to hospital") is the same action; a new one pauses.
AUTO_ACTION_MATCH_THRESHOLD=0.6
# Owner decision 2026-09-07 (pilot 486 F5): after an auto question, quiet
# counts toward a turn end only once the patient has spoken since it. With no
# speech inside this grace the question is re-asked once (auto.reask_no_answer);
# past a second grace the ordinary turn-end path proceeds.
AUTO_NO_ANSWER_GRACE_S=12
# Owner decision 2026-09-07 (pilot 486 F4): the open-question cone's topic
# identity — two topic strings are one topic at this token-set similarity
# ("this chest pain" and "the pain" opened the chest pain twice in 486).
AUTO_TOPIC_MATCH_THRESHOLD=0.6
# --- The standing question queue (AGENDA_QUEUE_SPEC.md, approved 2026-09-07) --
# Slice 1 lands the pure module inert; nothing reads these yet — the wiring
# (slice 2) and the re-ranker (slice 3) will.
# D-D: at most this many pending questions; lowest-ranked excess dropped, audited.
AUTO_QUEUE_MAX=8
# D-A: a pending question absent from this many consecutive passes is dropped.
AUTO_QUEUE_ABSENT_PASSES=3
# §3: the re-ranker call's timeout; on timeout the current order stands.
AUTO_RERANK_TIMEOUT_S=2.0
# D-B: the re-ranker's context — the last this-many transcript turns since
# the previous full pass, capped by characters.
AUTO_RERANK_CONTEXT_TURNS=6

# --- The model calls' output caps and the assessment timeout (app/cds.py) --
# Owner decision 2026-09-07 (pilot 486 F3): in 486 an assessment call ran
# away for 180 s (7,211+ tokens against a normal 500–620) and held Ollama's
# single slot. Every call carries a maximum output (num_predict): about three
# times the recorded normal for the long calls, small caps for the short
# ones. A call that hits its cap or timeout is audited cds.runaway and the
# pass fails: the previous assessment is kept, the urgency check still runs
# on its own call, and auto mode asks from the agenda it already has.
CDS_ASSESSMENT_MAX_TOKENS=1500
CDS_URGENCY_MAX_TOKENS=1000
CDS_AFFECT_MAX_TOKENS=800
AUTO_OFFICER_MAX_TOKENS=64
AUTO_TOPIC_MAX_TOKENS=48
# The assessment call's own timeout (was the generic 180 s).
CDS_ASSESSMENT_TIMEOUT_S=60

# --- The speaker-count wait at Stop (app/finalize.py) ----------------------
# How long the finalisation PIPELINE (never the recording) waits for the
# doctor's "Who spoke?" answer before defaulting to two (owner decision
# 2026-07-28, after consultation 450). Answering or Skip releases it at once.
SPEAKER_DECLARATION_WAIT_S=25
# The same wait for a consultation in which auto mode was enabled (owner
# decision 2026-09-01, solo pilot D6): the supervising doctor is not at the
# keyboard when Stop lands. On expiry the ignored-declaration path applies.
AUTO_SPEAKER_DECLARATION_WAIT_S=180
